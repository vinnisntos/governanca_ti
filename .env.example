# Copie este arquivo para .env.local (dev) ou .env (produção) e preencha
# com os valores do seu projeto Supabase (Project Settings > API).
#
# NUNCA versione o arquivo .env/.env.local preenchido (já ignorado no
# .gitignore) e NUNCA exponha SUPABASE_SERVICE_ROLE_KEY a código client-side
# ou a rotas alcançáveis por um colaborador comum — ela ignora todo o RLS.

# Seguros para expor ao browser (prefixo NEXT_PUBLIC_): esta chave só
# concede o que as policies de RLS permitirem para o papel autenticado.
# Aceita tanto a "anon key" (formato legado, JWT) quanto a nova
# "publishable key" (prefixo sb_publishable_...) do painel Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uso exclusivo no servidor, para rotinas administrativas internas
# (ex.: job de fechamento mensal de check-in). Bypassa o RLS.
# Aceita tanto a "service_role key" (legado) quanto a nova "secret key"
# (prefixo sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=
