# Copie este arquivo para .env.local (dev) ou .env (produção) e preencha
# com os valores do Postgres do Dokploy.
#
# NUNCA versione o arquivo .env/.env.local preenchido (já ignorado no
# .gitignore).

# Connection string do Postgres puro no Dokploy (sem PostgREST/RLS).
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# true liga TLS na conexão (ex.: banco fora da rede interna do Dokploy).
# Deixe em branco/false quando o Postgres é alcançado só pela rede interna.
DATABASE_SSL=false

# Diretório (num volume persistente do Dokploy) onde ficam as fotos de
# check-in e os contratos de hardware assinados.
STORAGE_ROOT=/data/storage

# Duração da sessão em horas (TTL deslizante). Opcional, padrão 12.
SESSION_TTL_HOURS=12

# Usados só pelo script scripts/seed-admin.ts, para criar o único usuário
# inicial (admin_ti) num banco novo/vazio. SEED_ADMIN_PASSWORD é opcional —
# sem ela, uma senha temporária é gerada e impressa uma única vez.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Sincronização automática do Catálogo de Acessos com a planilha "Assinaturas
# - Softwares e licenças" do Google Sheets (ver
# lib/integrations/software-catalog-sync.ts). Sem essas duas variáveis, a
# sincronização automática fica desativada e o botão "Sincronizar com a
# planilha" falha com erro.
#
# GOOGLE_SERVICE_ACCOUNT_KEY: JSON da chave de uma Service Account do Google
# Cloud (com a Sheets API habilitada e leitura concedida na planilha via
# "Compartilhar" com o e-mail da service account), em base64 — evita
# problemas de escaping das quebras de linha da private_key num .env.
# Gerar o base64 (a partir do JSON baixado no Console):
#   base64 -w0 service-account.json   (Linux/Git Bash)
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets).
GOOGLE_SHEETS_CATALOG_SPREADSHEET_ID=
# Hora (UTC, 0-23) em que a sincronização automática roda todo dia. Opcional,
# padrão 6 (03h em horário de Brasília).
CATALOG_SYNC_HOUR_UTC=6
